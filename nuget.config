<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <!-- typebeat.Game.Resources (art/audio/fonts) is not published to nuget.org; it is packed
         locally from a separate assets project and restored from a sibling `artifacts/` folder.
         Contributors without that project can point this at their own local package feed, or
         delete this source and drop a prebuilt typebeat.Game.Resources.*.nupkg into a local dir.
         The path is relative to this file. -->
    <add key="typebeat-assets" value="../type-beat-assets/artifacts" />
  </packageSources>
</configuration>
