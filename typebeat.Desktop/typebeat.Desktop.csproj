<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup Label="Project">
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Description>A free-to-win rhythm game. Rhythm is just a *click* away!</Description>
    <AssemblyName>type!beat</AssemblyName>
    <AssemblyTitle>type!beat</AssemblyTitle>
    <Title>type!beat</Title>
    <Product>type!beat</Product>
    <!-- The Windows PE resource icon. Despite the inherited file name this carries the type!beat
         icon, not osu!'s: lazer.ico, typb.ico and beatmap.ico are byte identical (backlog 163), and
         assets/typebeat.png is extracted from their 256x256 frame, so the exe, the window, the
         Linux package and the macOS bundle all show the same art. -->
    <ApplicationIcon>lazer.ico</ApplicationIcon>
    <Version>0.0.0</Version>
    <FileVersion>0.0.0</FileVersion>
  </PropertyGroup>
  <PropertyGroup>
    <StartupObject>typebeat.Desktop.Program</StartupObject>
  </PropertyGroup>
  <ItemGroup Label="Project References">
    <ProjectReference Include="..\typebeat.Game\typebeat.Game.csproj" />
    <ProjectReference Include="..\typebeat.Game.Rulesets.TypeBeat\typebeat.Game.Rulesets.TypeBeat.csproj" />
  </ItemGroup>
  <ItemGroup Label="Package References">
    <PackageReference Include="System.IO.Packaging" Version="10.0.9" />
    <!-- Held back due to invite bug in newer versions. See https://github.com/Lachee/discord-rpc-csharp/issues/286 -->
    <PackageReference Include="DiscordRichPresence" Version="1.5.0.51" />
    <PackageReference Include="Velopack" Version="0.0.1298" />
  </ItemGroup>
  <ItemGroup Label="Resources">
    <!-- The runtime window icon, handed to host.Window.SetIconFromStream by OsuGameDesktop.SetHost.
         It must be a PNG and not one of the .ico files next to it; see the comment there for why.
         assets/typebeat.png is the type!beat app icon, the same art the Linux and macOS CI icon
         steps build from and the same art typb.ico carries, so all four shipped surfaces move
         together. It replaced assets/lazer.png, which was osu!'s own logo and is ppy's IP.
         LogicalName is explicit because the file lives outside this project's directory.
         Forward slash for the same reason as the two ItemGroups below: it is the separator the
         Linux and macOS runners resolve, and MSBuild accepts it on Windows.
         Pinned by NonVisual/WindowIconTest. -->
    <EmbeddedResource Include="../assets/typebeat.png" LogicalName="typebeat.Desktop.typebeat.png" />
  </ItemGroup>
  <ItemGroup Label="Windows Icons">
    <Content Include="*.ico" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Label="Bundled Beatmaps">
    <!-- Shipped next to the exe; imported (and consumed) on first launch; see OsuGame.importBundledBeatmaps.
         The directory is gitignored (the packages carry non-redistributable audio), so it is EMPTY in a
         fresh clone and this glob matches nothing. What belongs in it is recorded in bundled-maps.manifest,
         and .github/scripts/bundled-maps.sh populates it: CI runs that before publishing and ship-client.ps1
         verifies the local copy before packing. Forward slash on purpose, MSBuild accepts it on Windows and
         it is the separator the Linux and macOS runners glob with. -->
    <Content Include="Bundled/*.typb" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup Label="Local Auto-Aligner Component">
    <!-- The lyriclab aligner scripts ship beside the exe; the "install local auto-aligner" action
         (first-run setup / settings) copies them into the game data directory and builds their
         Python environment there, so the multi-GB venv survives Velopack updates.
         See LyricMapImportService.InstallAsync. -->
    <Content Include="../lyriclab/align_lyrics.py;../lyriclab/debug_decode.py;../lyriclab/setup.ps1;../lyriclab/setup.sh;../lyriclab/README.md"
             LinkBase="lyriclab" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
